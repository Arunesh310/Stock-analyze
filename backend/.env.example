# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# SQLite (default, no setup):
DATABASE_URL=sqlite:///./app.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/bharatquant

# --- Vector DB ---
CHROMA_DIR=./chroma_store

# --- Ollama (free local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# --- Market data ---
DEFAULT_INDICES=^NSEI,^NSEBANK,^INDIAVIX
DEFAULT_FX=INR=X
DEFAULT_COMMODITIES=CL=F,GC=F
CACHE_TTL_SECONDS=60

# --- News (all free RSS) ---
NEWS_FEEDS=https://www.moneycontrol.com/rss/MCtopnews.xml,https://www.livemint.com/rss/markets,https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms,https://www.business-standard.com/rss/markets-106.rss,https://feeds.reuters.com/reuters/INbusinessNews
